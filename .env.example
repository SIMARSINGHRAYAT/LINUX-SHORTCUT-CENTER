# Linux Shortcut Center - Environment Configuration

# 1. GitHub OAuth App Client ID (Public - used on the client-side to redirect to GitHub)
VITE_GITHUB_CLIENT_ID=your_github_client_id_here

# 2. Vercel Serverless Function Variables (Private - used on Vercel backend to exchange auth code)
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
